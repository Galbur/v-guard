<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--c-gold);
  }

  .logo__mark {
    flex: none;
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .logo__word {
    display: block;
    height: 9.8px;
    width: auto;
    aspect-ratio: 541.7 / 70;
  }

  .logo__studio {
    font-size: 8px;
    line-height: 1;
    letter-spacing: 0.32em;
    color: var(--c-muted);
  }

  @media (min-width: 64rem) {
    .logo--header {
      gap: 10px;
    }

    .logo--header .logo__word {
      height: 11.2px;
    }

    .logo--header .logo__studio {
      font-size: 9px;
    }

    .logo--footer .logo__word {
      height: 10.5px;
    }
  }
</style>
