---
// Header 375 / 1280 and the mobile menu (mockup 8a, 8b, 8d). The menu is a native
// popover: no JS, Esc and outside click close it.
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { fullAddress, isLinked, site } from '../config/site.ts';
import { fromLabel, isPriceShown, serviceFrom, type ServiceSlug } from '../data/services.ts';
import { t, type UiKey } from '../i18n/index.ts';
import { localizedPath, type Locale, type PageKey } from '../i18n/routes.ts';

interface Props {
  locale: Locale;
  pageKey?: PageKey;
}

const { locale, pageKey } = Astro.props;

const labels: Partial<Record<PageKey, UiKey>> = {
  home: 'nav.home',
  ppf: 'nav.ppf',
  tint: 'nav.tint',
  wrap: 'nav.wrap',
  projects: 'nav.projects',
  contact: 'nav.contact',
};
const serviceOf: Partial<Record<PageKey, ServiceSlug>> = { ppf: 'ppf', tint: 'ramen-blinderen', wrap: 'car-wrapping' };
const toItem = (key: PageKey) => {
  const service = serviceOf[key];
  const price = service ? serviceFrom[service] : undefined;
  return {
    key,
    href: localizedPath(key, locale),
    label: t(labels[key]!, locale),
    price: isPriceShown(price) ? fromLabel(price, locale) : null,
    current: key === pageKey,
  };
};
const desktopItems = (['ppf', 'tint', 'wrap', 'projects', 'contact'] as PageKey[]).filter(isLinked).map(toItem);
const menuItems = (['home', 'ppf', 'tint', 'wrap', 'projects', 'contact'] as PageKey[]).filter(isLinked).map(toItem);
const contactHref = localizedPath('contact', locale);
---

<header class="hdr">
  <div class="hdr__bar">
    <a class="hdr__logo" href={localizedPath('home', locale)} aria-label={t('a11y.home', locale)}><Logo /></a>

    <nav class="hdr__nav" aria-label={t('nav.label', locale)}>
      {
        desktopItems.map((item) => (
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hdr__end">
      <LangSwitch locale={locale} pageKey={pageKey} />
      {
        isLinked('contact') && (
          <a class="btn btn--primary hdr__cta" href={contactHref}>
            {t('cta.quote', locale)}
          </a>
        )
      }
      <button class="hdr__icon-btn hdr__burger" type="button" popovertarget="menu" aria-label={t('nav.menuOpen', locale)}>
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
</header>

<div id="menu" class="menu" popover>
  <div class="menu__bar">
    <a class="hdr__logo" href={localizedPath('home', locale)} aria-label={t('a11y.home', locale)}><Logo /></a>
    <div class="hdr__end">
      <LangSwitch locale={locale} pageKey={pageKey} />
      <button
        class="hdr__icon-btn"
        type="button"
        popovertarget="menu"
        popovertargetaction="hide"
        aria-label={t('nav.menuClose', locale)}
      >
        <Icon name="close" size={20} />
      </button>
    </div>
  </div>
  <nav class="menu__nav" aria-label={t('nav.label', locale)}>
    {
      menuItems.map((item) => (
        <a class="menu__link" href={item.href} aria-current={item.current ? 'page' : undefined}>
          {item.label}
          {item.price && <span class="menu__price">{item.price}</span>}
        </a>
      ))
    }
    {
      isLinked('contact') && (
        <a class="btn btn--primary btn--block menu__cta" href={contactHref}>
          {t('cta.quote', locale)}
        </a>
      )
    }
    <p class="menu__nap">
      {fullAddress}<br />
      {site.phone.value.display} · {site.hours.value.label[locale]}
    </p>
  </nav>
</div>

<style>
  .hdr {
    background: var(--c-black);
    border-bottom: 1px solid var(--c-line-dark);
  }

  .hdr__bar,
  .menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding: 0 8px 0 16px;
    max-width: var(--container);
    margin-inline: auto;
  }

  .hdr__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .hdr__end {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .hdr__nav,
  .hdr__cta {
    display: none;
  }

  .hdr__icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--r-btn);
    background: none;
    color: var(--c-off-white);
    cursor: pointer;
  }

  /* Mobile menu: full screen above the page, sticky bar stays visible below it */
  .menu {
    position: fixed;
    inset: 0 0 calc(var(--sticky-h) + env(safe-area-inset-bottom)) 0;
    width: 100%;
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--c-black);
    color: var(--c-off-white);
    flex-direction: column;
    overflow-y: auto;
  }

  .menu:popover-open {
    display: flex;
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu__bar {
    flex: none;
    width: 100%;
    border-bottom: 1px solid var(--c-line-dark);
  }

  .menu__nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 16px 16px 0;
  }

  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    border-bottom: 1px solid var(--c-line-dark);
    font-size: 22px;
    font-weight: 600;
  }

  .menu__link[aria-current='page'] {
    color: var(--c-gold);
  }

  .menu__price {
    font-size: 13px;
    font-weight: 500;
    color: var(--c-muted);
  }

  .menu__cta {
    margin-top: 24px;
    min-height: 52px;
    font-size: 16px;
  }

  .menu__nap {
    margin-top: auto;
    padding: 24px 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--c-muted);
  }

  @media (min-width: 64rem) {
    .hdr__bar {
      height: 72px;
      padding: 0 40px;
    }

    .hdr__nav {
      display: flex;
      gap: 28px;
      font-size: 15px;
      font-weight: 500;
    }

    .hdr__nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      border-bottom: 1px solid transparent;
    }

    .hdr__nav a[aria-current='page'] {
      color: var(--c-gold);
    }

    .hdr__nav a[aria-current='page'] {
      border-bottom-color: var(--c-gold);
      min-height: 0;
      padding-bottom: 2px;
    }

    .hdr__end {
      gap: 20px;
    }

    .hdr__cta {
      display: inline-flex;
      min-height: 44px;
      font-size: 14px;
    }

    .hdr__burger,
    .menu {
      display: none !important;
    }
  }
</style>
