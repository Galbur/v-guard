---
// Before/after slider (Site Truth D13, owner decision R3): two real photos of one car.
// Without JS: two static photos (stacked on 375, side by side on 1280). With JS: a native
// <input type="range"> drives a clip-path, so mouse, touch and arrow keys all work.
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { t } from '../i18n/index.ts';
import type { Locale } from '../i18n/routes.ts';

interface Props {
  locale: Locale;
  title: string;
  before: ImageMetadata;
  after: ImageMetadata;
  position?: string;
  caption: string;
  alt: { before: string; after: string };
}

const { locale, title, before, after, position = 'center 58%', caption, alt } = Astro.props;
const sizes = '(min-width: 64rem) 960px, calc(100vw - 32px)';
---

<section class="section container">
  <h2 class="h2 ba__title">{title}</h2>
  <figure class="ba" style="--pos:50">
    <div class="ba__frame">
      <div class="ba__pane ba__pane--before">
        <Photo src={before} alt={alt.before} position={position} ratio="3/2" sizes={sizes} widths={[480, 720, 960, 1280]} />
        <span class="ba__tag">{t('common.voor', locale)}</span>
      </div>
      <div class="ba__pane ba__pane--after">
        <Photo src={after} alt={alt.after} position={position} ratio="3/2" sizes={sizes} widths={[480, 720, 960, 1280]} />
        <span class="ba__tag">{t('common.na', locale)}</span>
      </div>
      <div class="ba__divider" aria-hidden="true">
        <span class="ba__handle"><Icon name="arrows" size={20} /></span>
      </div>
      <input class="ba__range" type="range" min="0" max="100" value="50" aria-label={t('slider.label', locale)} hidden />
    </div>
    <figcaption>{caption}</figcaption>
  </figure>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.ba').forEach((figure) => {
    const range = figure.querySelector<HTMLInputElement>('.ba__range');
    if (!range) return;
    const update = () => {
      figure.style.setProperty('--pos', range.value);
      range.setAttribute('aria-valuetext', `${range.value}%`);
    };
    range.hidden = false;
    range.addEventListener('input', update);
    figure.dataset.js = '';
    update();
  });
</script>

<style>
  .ba__title {
    margin-bottom: 20px;
  }

  .ba__frame {
    display: grid;
    gap: 10px;
  }

  .ba__pane {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-btn);
    background: var(--c-graphite);
  }

  .ba__tag {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 5px 9px;
    border-radius: var(--r-badge);
    background: rgb(var(--c-overlay) / 0.75);
    font-size: 12px;
    font-weight: 600;
  }

  .ba__divider {
    display: none;
  }

  figcaption {
    margin-top: 12px;
    font-size: 13px;
    color: var(--c-muted);
  }

  /* Slider mode (JS on) */
  .ba[data-js] .ba__frame {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--r-btn);
  }

  .ba[data-js] .ba__pane {
    position: absolute;
    inset: 0;
    border-radius: 0;
  }

  .ba[data-js] .ba__pane :global(img) {
    height: 100%;
  }

  .ba[data-js] .ba__pane--before {
    z-index: 1;
    clip-path: inset(0 calc(100% - var(--pos) * 1%) 0 0);
  }

  .ba[data-js] .ba__pane--after .ba__tag {
    left: auto;
    right: 10px;
  }

  .ba[data-js] .ba__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--pos) * 1%);
    z-index: 2;
    display: block;
    width: 2px;
    margin-left: -1px;
    background: var(--c-off-white);
    pointer-events: none;
  }

  .ba__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-pill);
    background: var(--c-off-white);
    color: var(--c-black);
    transform: translate(-50%, -50%);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.4);
  }

  .ba__range {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .ba:has(.ba__range:focus-visible) .ba__divider {
    background: var(--c-gold);
  }

  .ba:has(.ba__range:focus-visible) .ba__handle {
    outline: var(--focus);
    outline-offset: var(--focus-offset);
  }

  @media (min-width: 64rem) {
    .ba__title {
      margin-bottom: 32px;
    }

    .ba__frame {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .ba[data-js] .ba__frame {
      max-width: 960px;
      margin-inline: auto;
    }

    .ba__tag {
      top: 14px;
      left: 14px;
      padding: 6px 10px;
      font-size: 13px;
    }

    .ba[data-js] .ba__pane--after .ba__tag {
      right: 14px;
    }

    .ba__handle {
      width: 48px;
      height: 48px;
    }

    figcaption {
      margin-top: 14px;
      font-size: 14px;
    }

    .ba[data-js] figcaption {
      text-align: center;
    }
  }
</style>
