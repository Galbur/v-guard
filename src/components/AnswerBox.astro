---
// «Wat is ...» answer block: plain HTML text inside the first 100 words (design prompt 13).
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<section class="answer container">
  <h2 class="h2">{title}</h2>
  <p class="answer__text">{text}</p>
</section>

<style>
  .answer {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 48px;
  }

  .answer__text {
    font-size: 16px;
    line-height: 1.55;
    color: var(--c-text-soft);
    text-wrap: pretty;
  }

  @media (min-width: 64rem) {
    .answer {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 48px;
      padding-top: 88px;
    }

    .answer__text {
      font-size: 20px;
      max-width: 720px;
    }
  }
</style>
