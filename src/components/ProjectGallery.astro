---
// Real project photos with captions (block specs: car + service + film, up to 12 words).
// Only entries with a real photo exist (R4); with no entries the block does not render.
// Optional filter on Projecten: CSS only (radio + :has), no JS.
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';
import { getService, services } from '../data/services.ts';
import { t } from '../i18n/index.ts';
import type { Locale } from '../i18n/routes.ts';

interface Props {
  locale: Locale;
  title?: string;
  items: CollectionEntry<'projects'>[];
  /** detail: «car · detail · film» (service pages, home); service: «car · service · detail» (Projecten). */
  caption?: 'detail' | 'service';
  more?: { href: string; label: string };
  filter?: boolean;
  /** Projecten has the H1 above; no own section heading. */
  headingLevel?: 2 | 'none';
}

const { locale, title, items, caption = 'detail', more, filter = false, headingLevel = 2 } = Astro.props;

const dienst: Record<string, Record<Locale, string>> = {
  ppf: { nl: 'PPF', uk: 'PPF' },
  'ramen-blinderen': { nl: 'ramen blinderen', uk: 'тонування' },
  'car-wrapping': { nl: 'car wrapping', uk: 'car wrapping' },
};

const view = items.map((entry) => {
  const p = entry.data;
  const car = p.car[locale];
  const detail = p.detail[locale];
  const [lead] = p.services;
  const labels = p.services.map((s) => getService(s)?.label[locale]);
  // PPF on service pages: «{merk model} · PPF {pakket}».
  const parts =
    caption === 'service'
      ? [car, ...labels, detail]
      : lead === 'ppf'
        ? [car, `PPF ${detail}`.trim()]
        : [car, detail || labels[0]?.toLowerCase(), p.film];
  // Work done outside the Vroomshoop building (D29): no studio or town in the alt.
  const alt = p.offsite
    ? locale === 'nl'
      ? `${car} met ${dienst[lead].nl} door een specialist van V Guard Studio`
      : lead === 'ppf'
        ? `${car} з PPF від спеціаліста V Guard Studio`
        : `${car}: ${dienst[lead].uk} від спеціаліста V Guard Studio`
    : locale === 'nl'
      ? `${car} met ${dienst[lead].nl} door V Guard Studio in Vroomshoop`
      : lead === 'ppf'
        ? `${car} з PPF від V Guard Studio у Vroomshoop`
        : `${car}: ${dienst[lead].uk} від V Guard Studio у Vroomshoop`;
  const count = p.images.length;
  return {
    id: entry.id,
    services: p.services,
    // Extra frames say which frame they are, so a screen reader does not hear the same alt three times.
    images: p.images.map((img, i) => ({
      src: img.src,
      alt:
        img.alt?.[locale] ??
        (i === 0 ? alt : `${alt} (${locale === 'nl' ? `foto ${i + 1} van ${count}` : `фото ${i + 1} з ${count}`})`),
    })),
    position: p.position,
    caption: parts.filter(Boolean).join(' · '),
    car,
  };
});
// Chips follow the service order of the site (PPF, ramen blinderen, car wrapping).
const servicesPresent = services.map((s) => s.slug).filter((s) => view.some((v) => v.services.includes(s)));
const filters = filter && servicesPresent.length > 1 ? servicesPresent : [];
---

{
  view.length > 0 && (
    <section class:list={['gallery container', headingLevel === 'none' ? 'gallery--bare' : 'section']}>
      {headingLevel !== 'none' && title && (
        <div class="gallery__head">
          <h2 class="h2">{title}</h2>
          {more && (
            <a class="btn btn--ghost gallery__more gallery__more--top" href={more.href}>
              {more.label}
            </a>
          )}
        </div>
      )}
      {filters.length > 0 && (
        <fieldset class="gallery__filter">
          <legend class="visually-hidden">{t('gallery.filter', locale)}</legend>
          <input class="visually-hidden" type="radio" name="project-filter" id="pf-all" value="all" checked />
          <label class="gallery__chip" for="pf-all">
            {t('gallery.all', locale)}
          </label>
          {filters.map((s) => (
            <>
              <input class="visually-hidden" type="radio" name="project-filter" id={`pf-${s}`} value={s} />
              <label class="gallery__chip" for={`pf-${s}`}>
                {getService(s)?.label[locale]}
              </label>
            </>
          ))}
        </fieldset>
      )}
      <ul class="gallery__grid" role="list">
        {view.map((item) => (
          <li data-services={item.services.join(' ')}>
            <figure>
              {item.images.length === 1 ? (
                <Photo
                  src={item.images[0].src}
                  alt={item.images[0].alt}
                  position={item.position}
                  ratio="4/3"
                  class="gallery__img"
                  widths={[360, 540, 720]}
                  sizes="(min-width: 64rem) 384px, calc(50vw - 22px)"
                />
              ) : (
                // Several frames: a swipeable scroll-snap strip, first frame is the card photo. No JS.
                <div class="gallery__frames">
                  <ul
                    class="gallery__strip"
                    role="list"
                    tabindex="0"
                    aria-label={`${item.car}: ${item.images.length} ${locale === 'nl' ? "foto's" : 'фото'}`}
                  >
                    {item.images.map((img, i) => (
                      <li>
                        <Photo
                          src={img.src}
                          alt={img.alt}
                          position={i === 0 ? item.position : 'center'}
                          ratio="4/3"
                          class="gallery__img"
                          widths={[360, 540, 720]}
                          sizes="(min-width: 64rem) 384px, calc(50vw - 22px)"
                        />
                      </li>
                    ))}
                  </ul>
                  <span class="gallery__count" aria-hidden="true">
                    {item.images.length} {locale === 'nl' ? "foto's" : 'фото'}
                  </span>
                </div>
              )}
              <figcaption>{item.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      {more && (
        <a class="btn btn--ghost btn--block gallery__more gallery__more--bottom" href={more.href}>
          {more.label}
        </a>
      )}
    </section>
  )
}

<style>
  .gallery__head {
    margin-bottom: 20px;
  }

  .gallery--bare {
    padding-top: 28px;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 12px;
    list-style: none;
    padding: 0;
  }

  :global(.gallery__img) {
    border-radius: var(--r-btn);
  }

  .gallery__frames {
    position: relative;
  }

  .gallery__strip {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    border-radius: var(--r-btn);
    list-style: none;
    padding: 0;
    margin: 0;
    scrollbar-width: none;
  }

  .gallery__strip::-webkit-scrollbar {
    display: none;
  }

  .gallery__strip:focus-visible {
    outline: var(--focus);
    outline-offset: var(--focus-offset);
  }

  .gallery__strip > li {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .gallery__strip :global(.gallery__img) {
    border-radius: 0;
  }

  /* Static hint that the photo swipes; the strip itself has the frame count in its label. */
  .gallery__count {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 2px 8px;
    border-radius: var(--r-pill);
    background: rgb(var(--c-overlay) / 0.7);
    color: var(--c-off-white);
    font-size: 12px;
    line-height: 20px;
    pointer-events: none;
  }

  figcaption {
    margin-top: 6px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--c-muted);
  }

  .gallery__more--top {
    display: none;
  }

  .gallery__more--bottom {
    margin-top: 20px;
  }

  .gallery__filter {
    display: flex;
    gap: 8px;
    margin: 0 calc(-1 * var(--gutter)) 24px;
    padding: 0 var(--gutter);
    border: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .gallery__chip {
    display: inline-flex;
    align-items: center;
    flex: none;
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--c-border-dark);
    border-radius: var(--r-pill);
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
  }

  .gallery__filter input:checked + .gallery__chip {
    background: var(--c-gold);
    border-color: var(--c-gold);
    color: var(--c-black);
    font-weight: 600;
  }

  .gallery__filter input:focus-visible + .gallery__chip {
    outline: var(--focus);
    outline-offset: var(--focus-offset);
  }

  .gallery:has(#pf-ppf:checked) .gallery__grid > li:not([data-services~='ppf']),
  .gallery:has(#pf-ramen-blinderen:checked) .gallery__grid > li:not([data-services~='ramen-blinderen']),
  .gallery:has(#pf-car-wrapping:checked) .gallery__grid > li:not([data-services~='car-wrapping']) {
    display: none;
  }

  @media (min-width: 64rem) {
    .gallery__head {
      display: flex;
      justify-content: space-between;
      align-items: end;
      margin-bottom: 32px;
    }

    .gallery__more--top {
      display: inline-flex;
      min-height: 46px;
    }

    .gallery__more--bottom {
      display: none;
    }

    .gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px 24px;
    }

    figcaption {
      margin-top: 10px;
      font-size: 14px;
    }

    .gallery__strip {
      scrollbar-width: thin;
    }

    .gallery__filter {
      flex-wrap: wrap;
      margin: 0 0 32px;
      padding: 0;
    }
  }
</style>
