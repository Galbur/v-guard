---
import { isLinked, site, waDigits } from '../config/site.ts';
import { t } from '../i18n/index.ts';
import { localizedPath, type Locale } from '../i18n/routes.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// Buttons whose number is not confirmed (null) are not rendered.
const actions = [
  site.whatsapp && { label: t('cta.whatsapp', locale), href: `https://wa.me/${waDigits(site.whatsapp)}`, external: true },
  site.phone && { label: t('sticky.call', locale), href: `tel:${site.phone}`, external: false },
  isLinked('contact') && { label: t('sticky.quote', locale), href: localizedPath('contact', locale), external: false },
].filter((a): a is { label: string; href: string; external: boolean } => Boolean(a));
---

{
  actions.length > 0 && (
    <nav class="sticky-bar" aria-label={t('sticky.label', locale)}>
      {actions.map((a) => (
        <a class="sticky-bar__btn" href={a.href} {...(a.external ? { target: '_blank', rel: 'noopener' } : {})}>
          {a.label}
        </a>
      ))}
    </nav>
  )
}

<style>
  .sticky-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    display: grid;
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    gap: var(--space-2);
    min-height: var(--sticky-h);
    padding: var(--space-2) var(--gutter) calc(var(--space-2) + env(safe-area-inset-bottom));
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .sticky-bar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    border-radius: var(--radius);
    background: var(--color-primary);
    color: var(--color-primary-text);
    font-weight: 600;
    text-decoration: none;
  }

  @media (min-width: 64rem) {
    .sticky-bar {
      display: none;
    }
  }
</style>
