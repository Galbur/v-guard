---
// Always-visible mobile CTA bar (mockup 8c): WhatsApp · Bellen · Offerte. Hidden from 1024 px.
import Icon from './Icon.astro';
import { isLinked, site, whatsappUrl } from '../config/site.ts';
import { t } from '../i18n/index.ts';
import { localizedPath, type Locale } from '../i18n/routes.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<nav class="sticky" aria-label={t('sticky.label', locale)}>
  <a class="sticky__btn" href={whatsappUrl()} target="_blank" rel="noopener">
    <Icon name="whatsapp" size={18} />{t('sticky.whatsapp', locale)}
  </a>
  <a class="sticky__btn" href={`tel:${site.phone.value.e164}`}>
    <Icon name="phone" size={18} />{t('sticky.call', locale)}
  </a>
  {
    isLinked('contact') && (
      <a class="sticky__btn sticky__btn--primary" href={localizedPath('contact', locale)}>
        <Icon name="doc" size={18} />
        {t('sticky.quote', locale)}
      </a>
    )
  }
</nav>

<style>
  .sticky {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 8px;
    padding: 8px 12px calc(12px + env(safe-area-inset-bottom));
    background: var(--c-black);
    border-top: 1px solid var(--c-line-dark);
  }

  .sticky__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 48px;
    border-radius: var(--r-btn);
    border: 1px solid var(--c-border-dark);
    background: var(--c-graphite);
    color: var(--c-off-white);
    font-size: 14px;
    font-weight: 600;
  }

  .sticky__btn--primary {
    border-color: var(--c-gold);
    background: var(--c-gold);
    color: var(--c-black);
  }

  @media (min-width: 64rem) {
    .sticky {
      display: none;
    }
  }
</style>
