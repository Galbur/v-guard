---
// Line icons of the wrap mockup (stroke = currentColor). Decorative: always aria-hidden.
export type WrapIconName = 'shield' | 'layers' | 'eye' | 'pin' | 'sliders' | 'chat' | 'flag';

interface Props {
  name: WrapIconName;
  size?: number;
  class?: string;
}

const paths: Record<WrapIconName, string> = {
  shield: 'M12 3l8 3v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6zM8.5 12l2.5 2.5 4.5-5',
  layers: 'M3 8l9-4 9 4-9 4-9-4zM3 12l9 4 9-4M3 16l9 4 9-4',
  eye: 'M12 5c5 0 9 7 9 7s-4 7-9 7-9-7-9-7 4-7 9-7zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z',
  pin: 'M12 21s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11zM12 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6z',
  sliders: 'M4 7h16M4 12h16M4 17h16M9 5v4M15 10v4M7 15v4',
  chat: 'M4 5h16v11H9l-5 4z',
  flag: 'M5 21V4h12l-2 4 2 4H5',
};

const { name, size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"><path d={paths[name]}></path></svg
>
