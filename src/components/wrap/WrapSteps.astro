---
// «Zo werkt het»: four numbered steps with icons (mockup v2). List at 375, row at 1280.
import WrapIcon, { type WrapIconName } from './WrapIcon.astro';

interface Props {
  title: string;
  steps: { icon: WrapIconName; text: string }[];
}

const { title, steps } = Astro.props;
---

<section class="section container">
  <h2 class="h2 wsteps__title">{title}</h2>
  <ol class="wsteps" role="list">
    {
      steps.map((s, i) => (
        <li class="wsteps__item">
          <span class="wsteps__n" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <WrapIcon name={s.icon} size={18} class="wsteps__icon" />
          <span class="wsteps__text">{s.text}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .wsteps__title {
    margin-bottom: 12px;
  }

  .wsteps {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--c-line-dark);
  }

  .wsteps__item {
    display: grid;
    grid-template-columns: 36px auto 1fr;
    align-items: center;
    gap: 0 14px;
    padding: 16px 0;
    border-top: 1px solid var(--c-line-dark);
  }

  .wsteps__n {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--c-gold);
    border-radius: var(--r-pill);
    color: var(--c-gold);
    font-size: 13px;
    font-weight: 600;
  }

  :global(.wsteps__icon) {
    margin-right: -4px;
    color: var(--c-gold);
  }

  .wsteps__text {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (min-width: 64rem) {
    .wsteps__title {
      margin-bottom: 40px;
    }

    .wsteps {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
      border: 0;
    }

    .wsteps__item {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      gap: 14px 0;
      padding: 20px 0 0;
      border-top-color: var(--c-gold);
    }

    .wsteps__n {
      width: auto;
      height: auto;
      justify-content: flex-start;
      border: 0;
      letter-spacing: 0.08em;
    }

    :global(.wsteps__icon) {
      width: 22px;
      height: 22px;
      margin: 0;
    }

    .wsteps__text {
      grid-column: 1 / -1;
      font-size: 19px;
    }
  }
</style>
