---
// Responsive photo: AVIF + WebP srcset, explicit width/height, lazy unless eager.
// Crop and ratio are classes, not style="": the Netlify CSP (style-src 'self') ignores inline styles.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { positionClasses } from '../lib/position.ts';
import '../styles/object-position.css';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS sizes attribute. */
  sizes: string;
  widths?: number[];
  /** object-position for cover crops. */
  position?: string;
  ratio?: '4/3' | '16/9' | '3/2';
  eager?: boolean;
  class?: string;
}

const { src, alt, sizes, widths = [400, 640, 960, 1280], position = 'center', ratio, eager = false, class: className } = Astro.props;
const usable = widths.filter((w) => w <= src.width);
const ratioClass = ratio ? `photo--r${ratio.replace('/', 'x')}` : undefined;
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  widths={usable.length ? usable : [src.width]}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : 'auto'}
  class:list={['photo', ratioClass, ...positionClasses(position), className]}
/>

<style>
  :global(.photo) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: var(--ox, 50%) var(--oy, 50%);
  }

  :global(.photo--r4x3) {
    aspect-ratio: 4 / 3;
  }

  :global(.photo--r16x9) {
    aspect-ratio: 16 / 9;
  }

  :global(.photo--r3x2) {
    aspect-ratio: 3 / 2;
  }
</style>
