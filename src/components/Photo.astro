---
// Responsive photo: AVIF + WebP srcset, explicit width/height, lazy unless eager.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS sizes attribute. */
  sizes: string;
  widths?: number[];
  /** object-position for cover crops. */
  position?: string;
  ratio?: '4/3' | '16/9' | '3/2';
  eager?: boolean;
  class?: string;
}

const { src, alt, sizes, widths = [400, 640, 960, 1280], position = 'center', ratio, eager = false, class: className } = Astro.props;
const usable = widths.filter((w) => w <= src.width);
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  widths={usable.length ? usable : [src.width]}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : 'auto'}
  class:list={['photo', className]}
  style={`object-position:${position};${ratio ? `aspect-ratio:${ratio};` : ''}`}
/>

<style>
  :global(.photo) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
</style>
