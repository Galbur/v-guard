---
// Base quote form (Blueprint v1.3 section 6, design prompt section 11, mockups 7a-7f).
// Without JS all steps are visible and the form posts natively to Netlify; with JS it is a
// 4-step flow with validation, «Terug» that keeps values, ?service= / &option= preselect,
// and a success state with the WhatsApp continuation. The wrap configurator also passes
// &body= (carrosserie), &finish=, &kleur= and &delen= (step W3).
import Icon from './Icon.astro';
import { linkPhone, waDigits } from '../config/site.ts';
import { adviceOption, bodyTypes, optionDetail, services, wrapFinishes, wrapParts } from '../data/services.ts';
import { t, type UiKey } from '../i18n/index.ts';
import { localizedPath, type Locale } from '../i18n/routes.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const serviceChoices = [
  ...services.map((s) => ({ id: s.slug, label: s.label[locale] })),
  { id: adviceOption.id, label: adviceOption.label[locale] },
];
const messageKeys: UiKey[] = [
  'form.progress',
  'form.err.required',
  'form.err.choose',
  'form.err.phone',
  'form.err.email',
  'form.err.year',
  'form.err.privacy',
  'form.err.submit',
  'form.sending',
  'form.submit',
  'form.wa.intro',
  'form.wa.service',
  'form.wa.option',
  'form.wa.car',
  'form.wa.kleur',
];
const messages = Object.fromEntries(messageKeys.map((k) => [k, t(k, locale)]));
// Empty without TEST_PHONE: the WhatsApp continuation button is then not rendered.
const wa = linkPhone ? waDigits(linkPhone) : '';
const pagePath = localizedPath('contact', locale);
// Labels for the wrap configurator prefill (finish id and part ids in the URL).
const wrapLabels = {
  finishes: Object.fromEntries(wrapFinishes.map((f) => [f.id, f.label[locale]])),
  parts: Object.fromEntries(wrapParts.map((p) => [p.id, p.label[locale]])),
};
---

<div
  class="quote"
  data-quote
  data-wa={wa}
  data-messages={JSON.stringify(messages)}
  data-wrap-labels={JSON.stringify(wrapLabels)}
>
  <form
    class="quote__card surface-light"
    name="offerte"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    aria-label={t('form.label', locale)}
  >
    <input type="hidden" name="form-name" value="offerte" />
    <input type="hidden" name="taal" value={locale} />
    <input type="hidden" name="pagina" value={pagePath} />
    <p class="visually-hidden" aria-hidden="true">
      <label>
        {t('form.honeypot', locale)}
        <input name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div class="quote__progress" data-progress hidden>
      <p data-progress-text></p>
      <div class="quote__bars" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    </div>

    <fieldset class="quote__step" data-step="service">
      <legend><h2 class="quote__title" tabindex="-1">{t('form.step.service', locale)}</h2></legend>
      <div class="tiles">
        {
          serviceChoices.map((c) => (
            <label class="tile">
              <input class="visually-hidden" type="radio" name="dienst" value={c.id} required aria-describedby="err-dienst" />
              <Icon name="check" size={22} class="tile__check" />
              <span class="tile__label">{c.label}</span>
            </label>
          ))
        }
      </div>
      <p class="field__error" id="err-dienst" hidden></p>
    </fieldset>

    <fieldset class="quote__step" data-step="car">
      <legend><h2 class="quote__title" tabindex="-1">{t('form.step.car', locale)}</h2></legend>
      <div class="field">
        <label for="f-merk">{t('form.merk', locale)}</label>
        <input
          id="f-merk"
          name="merk"
          type="text"
          required
          autocomplete="off"
          placeholder={t('form.merk.placeholder', locale)}
          aria-describedby="err-merk"
        />
        <p class="field__error" id="err-merk" hidden></p>
      </div>
      <div class="field">
        <label for="f-model">{t('form.model', locale)}</label>
        <input
          id="f-model"
          name="model"
          type="text"
          required
          autocomplete="off"
          placeholder={t('form.model.placeholder', locale)}
          aria-describedby="err-model"
        />
        <p class="field__error" id="err-model" hidden></p>
      </div>
      <div class="field">
        <label for="f-bouwjaar">{t('form.bouwjaar', locale)}</label>
        <input
          id="f-bouwjaar"
          name="bouwjaar"
          type="text"
          inputmode="numeric"
          maxlength="4"
          autocomplete="off"
          placeholder={t('form.bouwjaar.placeholder', locale)}
          aria-describedby="err-bouwjaar"
        />
        <p class="field__error" id="err-bouwjaar" hidden></p>
      </div>
      <fieldset class="field">
        <legend>{t('form.carrosserie', locale)}</legend>
        <div class="pills">
          {
            bodyTypes.map((b) => (
              <label class="pill">
                <input
                  class="visually-hidden"
                  type="radio"
                  name="carrosserie"
                  value={b.id}
                  required
                  aria-describedby="err-carrosserie"
                />
                <span>{b.label[locale]}</span>
              </label>
            ))
          }
        </div>
        <p class="field__error" id="err-carrosserie" hidden></p>
      </fieldset>
    </fieldset>

    <fieldset class="quote__step" data-step="option">
      <legend><h2 class="quote__title" tabindex="-1">{t('form.step.option', locale)}</h2></legend>
      {
        services.map((s) => (
          <div class="options" data-options-for={s.slug}>
            <p class="options__service">{s.label[locale]}</p>
            {s.options.map((o) => {
              const detail = optionDetail(s.slug, o.id, locale);
              return (
                <label class="option">
                  <input class="visually-hidden" type="radio" name="optie" value={o.id} aria-describedby="err-optie" />
                  <span>
                    <span class="option__title">{o.label[locale]}</span>
                    {detail && <span class="option__detail">{detail}</span>}
                  </span>
                  <Icon name="check-circle" size={24} class="option__check" />
                </label>
              );
            })}
            {s.slug === 'car-wrapping' && (
              <div class="field options__extra">
                <label for="f-kleur">{t('form.kleur', locale)}</label>
                <input
                  id="f-kleur"
                  name="kleur"
                  type="text"
                  autocomplete="off"
                  placeholder={t('form.kleur.placeholder', locale)}
                />
              </div>
            )}
          </div>
        ))
      }
      <p class="field__error" id="err-optie" hidden></p>
    </fieldset>

    <fieldset class="quote__step" data-step="contact">
      <legend><h2 class="quote__title" tabindex="-1">{t('form.step.contact', locale)}</h2></legend>
      <div class="field">
        <label for="f-naam">{t('form.naam', locale)}</label>
        <input id="f-naam" name="naam" type="text" required autocomplete="name" aria-describedby="err-naam" />
        <p class="field__error" id="err-naam" hidden></p>
      </div>
      <div class="field">
        <label for="f-telefoon">{t('form.telefoon', locale)}</label>
        <input id="f-telefoon" name="telefoon" type="tel" required autocomplete="tel" aria-describedby="err-telefoon" />
        <p class="field__error" id="err-telefoon" hidden></p>
      </div>
      <div class="field">
        <label for="f-email">{t('form.email', locale)}</label>
        <input id="f-email" name="email" type="email" autocomplete="email" aria-describedby="err-email" />
        <p class="field__error" id="err-email" hidden></p>
      </div>
      <div class="field">
        <label for="f-opmerking">{t('form.opmerking', locale)}</label>
        <textarea id="f-opmerking" name="opmerking" rows="3" placeholder={t('form.opmerking.placeholder', locale)}
        ></textarea>
      </div>
      <div class="check">
        <input id="f-privacy" name="privacy" type="checkbox" value="ja" required aria-describedby="err-privacy" />
        <label for="f-privacy">
          {t('form.privacy.before', locale)}
          <a href={localizedPath('privacy', locale)} target="_blank">{t('form.privacy.link', locale)}</a>{
            t('form.privacy.after', locale)
          }
        </label>
        <p class="field__error" id="err-privacy" hidden></p>
      </div>
    </fieldset>

    <div class="quote__nav">
      <button class="btn btn--ghost-light" type="button" data-back hidden>{t('form.back', locale)}</button>
      <button class="btn btn--primary" type="button" data-next hidden>{t('form.next', locale)}</button>
      <button class="btn btn--primary" type="submit" data-submit>{t('form.submit', locale)}</button>
    </div>
    <p class="field__error quote__submit-error" data-submit-error role="alert" hidden></p>
  </form>

  <div class="quote__card quote__success surface-light" data-success hidden>
    <Icon name="check-circle" size={40} class="success__icon" />
    <h2 tabindex="-1">{t('form.success.title', locale)}</h2>
    <p>{t('form.success.text', locale)}</p>
    {
      wa && (
        <a class="btn btn--primary btn--block" data-wa-link href={`https://wa.me/${wa}`} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={18} />
          {t('form.success.wa', locale)}
        </a>
      )
    }
    <a class="success__home" href={localizedPath('home', locale)}>{t('form.success.home', locale)}</a>
  </div>
</div>

<script>
  type Messages = Record<string, string>;
  type StepId = 'service' | 'car' | 'option' | 'contact';

  const MIN_YEAR = 1950;

  function fill(template: string, params: Record<string, string | number>): string {
    return template.replace(/\{(\w+)\}/g, (m, k: string) => (k in params ? String(params[k]) : m));
  }

  function init(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('form')!;
    const messages: Messages = JSON.parse(root.dataset.messages ?? '{}');
    const steps = Array.from(form.querySelectorAll<HTMLFieldSetElement>('[data-step]'));
    const progress = form.querySelector<HTMLElement>('[data-progress]')!;
    const progressText = form.querySelector<HTMLElement>('[data-progress-text]')!;
    const bars = Array.from(progress.querySelectorAll<HTMLElement>('.quote__bars span'));
    const back = form.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitError = form.querySelector<HTMLElement>('[data-submit-error]')!;
    const success = root.querySelector<HTMLElement>('[data-success]')!;
    const optionGroups = Array.from(form.querySelectorAll<HTMLElement>('[data-options-for]'));
    const maxYear = new Date().getFullYear() + 1;
    let current = 0;

    form.noValidate = true;
    root.dataset.enhanced = '';
    form.querySelector<HTMLInputElement>('[name="pagina"]')!.value = location.pathname + location.search;

    const field = (name: string) => form.elements.namedItem(name);
    const value = (name: string): string => {
      const el = field(name);
      return el && 'value' in el ? String(el.value).trim() : '';
    };
    const checkedLabel = (name: string): string => {
      const input = form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked:not(:disabled)`);
      const label = input?.closest('label');
      return (label?.querySelector('.option__title, .tile__label') ?? label)?.textContent?.trim() ?? '';
    };
    const service = () => value('dienst');
    // Until a service is chosen the option step counts; advice has no options.
    const hasOptions = () => !service() || optionGroups.some((g) => g.dataset.optionsFor === service());

    // Only the option group of the chosen service is enabled and submitted.
    function syncOptions() {
      for (const group of optionGroups) {
        const active = group.dataset.optionsFor === service();
        group.hidden = !active;
        group.querySelectorAll<HTMLInputElement>('input').forEach((i) => (i.disabled = !active));
      }
    }

    const visibleSteps = () => steps.filter((s) => s.dataset.step !== 'option' || hasOptions());

    // Controls behind a field name; for optie only the enabled group.
    function controls(name: string): HTMLInputElement[] {
      const selector = name === 'optie' ? 'input[name="optie"]:not(:disabled)' : `[name="${name}"]`;
      return Array.from(form.querySelectorAll<HTMLInputElement>(selector));
    }

    function setError(name: string, message: string | null) {
      const el = form.querySelector<HTMLElement>(`#err-${name}`);
      if (el) {
        el.textContent = message ?? '';
        el.hidden = !message;
      }
      controls(name).forEach((c) => c.setAttribute('aria-invalid', message ? 'true' : 'false'));
    }

    function validate(step: StepId): HTMLElement | null {
      const errors: [string, string | null][] = [];
      if (step === 'service') {
        errors.push(['dienst', service() ? null : messages['form.err.choose']]);
      } else if (step === 'car') {
        errors.push(['merk', value('merk') ? null : messages['form.err.required']]);
        errors.push(['model', value('model') ? null : messages['form.err.required']]);
        const year = value('bouwjaar');
        const yearOk = !year || (/^\d{4}$/.test(year) && +year >= MIN_YEAR && +year <= maxYear);
        errors.push(['bouwjaar', yearOk ? null : fill(messages['form.err.year'], { max: maxYear })]);
        errors.push(['carrosserie', value('carrosserie') ? null : messages['form.err.choose']]);
      } else if (step === 'option') {
        errors.push(['optie', checkedLabel('optie') ? null : messages['form.err.choose']]);
      } else {
        errors.push(['naam', value('naam') ? null : messages['form.err.required']]);
        const phone = value('telefoon');
        const digits = phone.replace(/\D/g, '');
        const phoneOk = /^[+\d\s().-]+$/.test(phone) && digits.length >= 10 && digits.length <= 15;
        errors.push(['telefoon', phoneOk ? null : messages['form.err.phone']]);
        const email = value('email');
        errors.push(['email', !email || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? null : messages['form.err.email']]);
        const privacy = field('privacy') as HTMLInputElement;
        errors.push(['privacy', privacy.checked ? null : messages['form.err.privacy']]);
      }
      let first: HTMLElement | null = null;
      for (const [name, message] of errors) {
        setError(name, message);
        if (message && !first) first = controls(name)[0] ?? null;
      }
      return first;
    }

    function show(index: number, focus = true) {
      const visible = visibleSteps();
      current = Math.max(0, Math.min(index, visible.length - 1));
      steps.forEach((s) => (s.hidden = s !== visible[current]));
      progress.hidden = false;
      bars.forEach((bar, i) => {
        bar.hidden = i >= visible.length;
        bar.classList.toggle('is-done', i <= current);
      });
      progressText.textContent = fill(messages['form.progress'], { n: current + 1, total: visible.length });
      back.hidden = current === 0;
      next.hidden = current === visible.length - 1;
      submit.hidden = current !== visible.length - 1;
      form.dataset.first = current === 0 ? 'true' : 'false';
      if (focus) visible[current].querySelector<HTMLElement>('.quote__title')?.focus();
    }

    const currentStep = (): StepId => visibleSteps()[current].dataset.step as StepId;

    form.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.name === 'dienst') {
        syncOptions();
        show(current, false);
      }
      if (target.type === 'radio' || target.type === 'checkbox') setError(target.name, null);
    });

    next.addEventListener('click', () => {
      const invalid = validate(currentStep());
      if (invalid) return invalid.focus();
      show(current + 1);
    });

    back.addEventListener('click', () => show(current - 1));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Validate every visible step; jump to the first one with an error.
      const visible = visibleSteps();
      for (let i = 0; i < visible.length; i++) {
        const invalid = validate(visible[i].dataset.step as StepId);
        if (invalid) {
          show(i, false);
          return invalid.focus();
        }
      }
      submitError.hidden = true;
      submit.disabled = true;
      submit.textContent = messages['form.sending'];
      try {
        const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        showSuccess();
      } catch {
        submitError.textContent = messages['form.err.submit'];
        submitError.hidden = false;
        submit.disabled = false;
        submit.textContent = messages['form.submit'];
      }
    });

    function showSuccess() {
      const link = success.querySelector<HTMLAnchorElement>('[data-wa-link]');
      if (link && root.dataset.wa) {
        const car = [value('merk'), value('model'), value('bouwjaar')].filter(Boolean).join(' ');
        const lines = [
          messages['form.wa.intro'],
          `${messages['form.wa.service']}: ${checkedLabel('dienst')}`,
          checkedLabel('optie') && `${messages['form.wa.option']}: ${checkedLabel('optie')}`,
          value('kleur') && `${messages['form.wa.kleur']}: ${value('kleur')}`,
          `${messages['form.wa.car']}: ${[car, checkedLabel('carrosserie')].filter(Boolean).join(', ')}`,
        ].filter(Boolean);
        link.href = `https://wa.me/${root.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`;
      }
      form.hidden = true;
      success.hidden = false;
      success.querySelector<HTMLElement>('h2')?.focus();
    }

    // Preselect from ?service=ppf&option=full-front (QuoteEntry, PackageCards, CtaBand).
    const params = new URLSearchParams(location.search);
    const preService = form.querySelector<HTMLInputElement>(
      `input[name="dienst"][value="${CSS.escape(params.get('service') ?? '')}"]`,
    );
    if (preService) preService.checked = true;
    syncOptions();
    const preOption = form.querySelector<HTMLInputElement>(
      `input[name="optie"]:not(:disabled)[value="${CSS.escape(params.get('option') ?? params.get('optie') ?? '')}"]`,
    );
    if (preOption) preOption.checked = true;
    // Wrap configurator: carrosserie, colour with finish, and the chosen parts.
    const preBody = form.querySelector<HTMLInputElement>(
      `input[name="carrosserie"][value="${CSS.escape(params.get('body') ?? '')}"]`,
    );
    if (preBody) preBody.checked = true;
    const wrapLabels: { finishes: Record<string, string>; parts: Record<string, string> } = JSON.parse(
      root.dataset.wrapLabels ?? '{"finishes":{},"parts":{}}',
    );
    const kleur = form.querySelector<HTMLInputElement>('[name="kleur"]');
    const preKleur = [params.get('kleur'), wrapLabels.finishes[params.get('finish') ?? '']].filter(Boolean).join(', ');
    if (kleur && preKleur && !kleur.disabled) kleur.value = preKleur.slice(0, 120);
    const opmerking = form.querySelector<HTMLTextAreaElement>('[name="opmerking"]');
    const delen = (params.get('delen') ?? '')
      .split(',')
      .map((id) => wrapLabels.parts[id])
      .filter(Boolean);
    if (opmerking && delen.length && preService?.value === 'car-wrapping' && !opmerking.value) opmerking.value = delen.join(', ');
    show(preService ? 1 : 0, false);
  }

  document.querySelectorAll<HTMLElement>('[data-quote]').forEach(init);
</script>

<style>
  .quote__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px 16px;
  }

  .quote__step {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .quote__step > legend {
    float: left;
    width: 100%;
    padding: 0;
  }

  .quote__title {
    font-size: 20px;
    line-height: 1.2;
    font-weight: 600;
  }

  .quote__title:focus {
    outline: none;
  }

  .quote__progress {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--c-muted-light);
  }

  .quote__bars {
    display: flex;
    gap: 4px;
  }

  .quote__bars span {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: var(--c-line-light);
  }

  .quote__bars span.is-done {
    background: var(--c-gold);
  }

  /* Step 1 tiles */
  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 92px;
    padding: 12px;
    border: 1px solid var(--c-muted);
    border-radius: var(--r-card);
    background: var(--c-white);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
  }

  .tile :global(.tile__check) {
    position: absolute;
    top: 12px;
    left: 12px;
    display: none;
    color: var(--c-gold-text);
  }

  .tile:has(input:checked) {
    border: 2px solid var(--c-gold);
    padding: 11px;
  }

  .tile:has(input:checked) :global(.tile__check) {
    display: block;
  }

  /* Inputs */
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .field > label,
  .field > legend {
    padding: 0;
    font-size: 13px;
    font-weight: 600;
  }

  .field > legend {
    margin-bottom: 8px;
  }

  .field input,
  .field textarea {
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid var(--c-muted);
    border-radius: var(--r-btn);
    background: var(--c-white);
    color: var(--c-black);
    font: inherit;
    font-size: 16px;
  }

  .field textarea {
    min-height: 88px;
    padding: 12px 14px;
    resize: vertical;
  }

  .field ::placeholder {
    color: #767672;
  }

  .field input[aria-invalid='true'] {
    border: 2px solid var(--c-error);
    padding: 0 13px;
  }

  /* Body type pills */
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--c-muted);
    border-radius: var(--r-pill);
    background: var(--c-white);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }

  .pill:has(input:checked) {
    border: 2px solid var(--c-gold);
    padding: 0 13px;
    font-weight: 600;
  }

  /* Step 3 options */
  .options {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .options__service {
    font-weight: 600;
  }

  [data-enhanced] .options__service {
    display: none;
  }

  .options__extra {
    margin-top: 6px;
  }

  .option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
    padding: 14px 16px;
    border: 1px solid var(--c-muted);
