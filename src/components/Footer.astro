---
import { isLinked, site } from '../config/site.ts';
import { t, type UiKey } from '../i18n/index.ts';
import { localizedPath, pageKeys, type Locale, type PageKey } from '../i18n/routes.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pageLabel: Record<PageKey, UiKey> = {
  home: 'nav.home',
  ppf: 'nav.ppf',
  tint: 'nav.tint',
  wrap: 'nav.wrap',
  projects: 'nav.projects',
  contact: 'nav.contact',
  privacy: 'nav.privacy',
};
const pages = pageKeys.filter(isLinked);
// NAP from site.ts only; parts that are null are left out.
const addressLine = [site.address.street, [site.address.postalCode, site.address.locality].filter(Boolean).join(' ')]
  .filter(Boolean)
  .join(', ');
const socials = [
  { label: 'TikTok', href: site.socials.tiktok },
  { label: 'Instagram', href: site.socials.instagram },
  { label: 'Facebook', href: site.socials.facebook },
].filter((s): s is { label: string; href: string } => s.href !== null);
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="site-footer__name">{site.name}</p>
      <address>
        {addressLine && <span>{addressLine}</span>}
        {site.phone && <a href={`tel:${site.phone}`}>{site.phone}</a>}
      </address>
      {
        site.openingHours && (
          <>
            <p class="site-footer__heading">{t('footer.hours', locale)}</p>
            <ul>
              {site.openingHours.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </>
        )
      }
    </div>

    <nav aria-label={t('footer.pages', locale)}>
      <p class="site-footer__heading">{t('footer.pages', locale)}</p>
      <ul>
        {
          pages.map((key) => (
            <li>
              <a href={localizedPath(key, locale)}>{t(pageLabel[key], locale)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      socials.length > 0 && (
        <div>
          <p class="site-footer__heading">{t('footer.socials', locale)}</p>
          <ul>
            {socials.map((s) => (
              <li>
                <a href={s.href} rel="noopener" target="_blank">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      (site.legalName || site.kvk) && (
        <p class="site-footer__legal">
          {site.legalName}
          {site.kvk && ` · ${t('footer.kvk', locale)} ${site.kvk}`}
        </p>
      )
    }
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    padding-block: var(--space-8);
    font-size: var(--text-sm);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .site-footer__name,
  .site-footer__heading {
    font-weight: 700;
    margin: 0 0 var(--space-2);
  }

  address {
    font-style: normal;
    display: flex;
    flex-direction: column;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  .site-footer__legal {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
