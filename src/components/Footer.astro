---
// Footer 375 / 1280 (mockup 8e, 8f). NAP from site.ts only (CLAUDE.md rule 3).
// Socials render only with a URL (F16 ОЧІКУЄ).
import Logo from './Logo.astro';
import { fullAddress, isLinked, site } from '../config/site.ts';
import { t, type UiKey } from '../i18n/index.ts';
import { localizedPath, type Locale, type PageKey } from '../i18n/routes.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const link = (key: PageKey, label: UiKey) => ({ key, href: localizedPath(key, locale), label: t(label, locale) });
const servicesLinks = [link('ppf', 'nav.ppf'), link('tint', 'nav.tint'), link('wrap', 'nav.wrap')].filter((l) => isLinked(l.key));
const studioLinks = [link('home', 'nav.home'), link('projects', 'nav.projects'), link('contact', 'nav.contact')].filter((l) =>
  isLinked(l.key),
);
// Mobile order from mockup 8e: Home, PPF, Ramen blinderen, Car wrapping, Projecten, Contact.
const mobileLinks = [studioLinks[0], ...servicesLinks, ...studioLinks.slice(1)].filter(Boolean);
const socials = [
  { label: 'TikTok', href: site.socials.tiktok },
  { label: 'Instagram', href: site.socials.instagram },
  { label: 'Facebook', href: site.socials.facebook },
].filter((s): s is { label: string; href: string } => s.href !== null);
---

<footer class="ftr">
  <div class="ftr__inner">
    <div class="ftr__grid">
      <div class="ftr__brand">
        <Logo variant="footer" withStudio={false} />
        <p class="ftr__name">{site.name}</p>
        <p>
          {fullAddress}<br />
          <a href={`tel:${site.phone.value.e164}`}>{site.phone.value.display}</a><br />
          {site.hours.value.label[locale]}
        </p>
      </div>

      <nav class="ftr__links ftr__links--mobile" aria-label={t('footer.studio', locale)}>
        {mobileLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>

      <nav class="ftr__col" aria-label={t('footer.services', locale)}>
        <p class="ftr__heading">{t('footer.services', locale)}</p>
        {servicesLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <nav class="ftr__col" aria-label={t('footer.studio', locale)}>
        <p class="ftr__heading">{t('footer.studio', locale)}</p>
        {studioLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      {
        socials.length > 0 && (
          <div class="ftr__col ftr__col--socials">
            <p class="ftr__heading">{t('footer.socials', locale)}</p>
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener">
                {s.label}
              </a>
            ))}
          </div>
        )
      }
    </div>

    <div class="ftr__bottom">
      {isLinked('privacy') && <a href={localizedPath('privacy', locale)}>{t('nav.privacy', locale)}</a>}
      <span>{t('footer.kvk', locale)} {site.kvk.value}</span>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--c-footer);
    border-top: 1px solid var(--c-line-dark);
    color: var(--c-muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .ftr__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: 40px 16px 24px;
  }

  .ftr__grid {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .ftr__brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ftr__name {
    color: var(--c-off-white);
    font-weight: 500;
  }

  .ftr__brand a {
    display: inline-flex;
    min-height: 0;
  }

  .ftr__links--mobile {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 16px;
  }

  .ftr__links--mobile a,
  .ftr__col a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--c-off-white);
  }

  .ftr__col {
    display: none;
  }

  .ftr__col--socials {
    display: flex;
    gap: 20px;
  }

  .ftr__col--socials .ftr__heading {
    display: none;
  }

  .ftr__heading {
    color: var(--c-off-white);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ftr__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px solid var(--c-line-dark);
    font-size: 12px;
  }

  .ftr__bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (min-width: 64rem) {
    .ftr {
      font-size: 14px;
    }

    .ftr__inner {
      padding: 56px 40px 28px;
    }

    .ftr__grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 48px;
    }

    .ftr__brand {
      gap: 14px;
    }

    .ftr__links--mobile {
      display: none;
    }

    .ftr__col,
    .ftr__col--socials {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .ftr__col--socials .ftr__heading {
      display: block;
    }

    .ftr__col a {
      min-height: 0;
      color: var(--c-text-soft);
    }

    .ftr__bottom {
      margin-top: 48px;
      padding-top: 20px;
      font-size: 13px;
    }
  }
</style>
