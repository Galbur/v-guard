---
// Car wrapping «Volledig of gedeeltelijk»: cards with price and duration; a photo only when
// a real one exists (R4). Finishes as chips. Buttons preselect the form option.
import Photo from './Photo.astro';
import { fromLabel, isPriceShown, type WrapCard } from '../data/services.ts';
import { t } from '../i18n/index.ts';
import { localizedPath, type Locale } from '../i18n/routes.ts';
import { photo } from '../lib/photos.ts';

interface Props {
  locale: Locale;
  title: string;
  cards: WrapCard[];
  finishesLabel: string;
  finishes: string[];
  note: string;
}

const { locale, title, cards, finishesLabel, finishes, note } = Astro.props;
const contact = localizedPath('contact', locale);
const altFor = (card: WrapCard) =>
  locale === 'nl'
    ? `BMW 3 Serie met car wrapping (${card.title.nl.toLowerCase()}) door V Guard Studio in Vroomshoop`
    : `BMW 3 Series: car wrapping (${card.title.uk.toLowerCase()}) від V Guard Studio у Vroomshoop`;
---

<section class="section container">
  <h2 class="h2 wc__title">{title}</h2>
  <div class="wc">
    {
      cards.map((card) => (
        <article class:list={['wc__card surface-light', { 'wc__card--photo': card.photo }]}>
          {card.photo && (
            <Photo
              src={photo(card.photo.file)}
              alt={altFor(card)}
              position={card.photo.position}
              class="wc__img"
              widths={[240, 360, 480]}
              sizes="(min-width: 64rem) 282px, 120px"
            />
          )}
          <div class="wc__body">
            <h3 class="wc__name">{card.title[locale]}</h3>
            <p class="wc__desc">{card.description[locale]}</p>
            <div class="wc__meta">
              {isPriceShown(card.price) && <span class="wc__price">{fromLabel(card.price, locale)}</span>}
              <span class="wc__dur">{card.duration.value[locale]}</span>
            </div>
            <a class="btn btn--ghost-light btn--block wc__btn" href={`${contact}?service=car-wrapping&option=${card.formOption}`}>
              {t('cta.quote', locale)}
            </a>
          </div>
        </article>
      ))
    }
  </div>
  <div class="wc__finishes">
    <span class="wc__finishes-label">{finishesLabel}</span>
    <ul role="list">
      {finishes.map((f) => <li class="chip chip--dark">{f}</li>)}
    </ul>
  </div>
  <p class="note wc__note">{note}</p>
</section>

<style>
  .wc__title {
    margin-bottom: 16px;
  }

  .wc {
    display: grid;
    gap: 16px;
  }

  .wc__card {
    overflow: hidden;
  }

  .wc__card--photo {
    display: grid;
    grid-template-columns: 120px 1fr;
  }

  :global(.wc__img) {
    height: 100%;
  }

  .wc__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
  }

  .wc__name {
    font-size: 18px;
    font-weight: 600;
  }

  .wc__desc {
    font-size: 13px;
    line-height: 1.45;
    color: var(--c-muted-light);
  }

  .wc__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin-top: 2px;
  }

  .wc__price {
    font-size: 16px;
    font-weight: 600;
  }

  .wc__dur {
    font-size: 12px;
    color: var(--c-muted-light);
  }

  .wc__btn {
    margin-top: 6px;
    min-height: 44px;
    font-size: 14px;
  }

  .wc__finishes {
    margin-top: 20px;
  }

  .wc__finishes-label {
    display: none;
  }

  .wc__finishes ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
  }

  .chip--dark {
    border-color: var(--c-border-dark);
  }

  .wc__note {
    margin-top: 16px;
  }

  @media (min-width: 64rem) {
    .wc__title {
      margin-bottom: 32px;
    }

    .wc {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }

    .wc__card {
      display: flex;
      flex-direction: column;
    }

    .wc__card--photo {
      display: flex;
    }

    :global(.wc__img) {
      height: auto;
      aspect-ratio: 4/3;
    }

    .wc__body {
      flex: 1;
      gap: 8px;
      padding: 20px;
    }

    .wc__name {
      font-size: 20px;
    }

    .wc__desc {
      flex: 1;
      font-size: 14px;
    }

    .wc__price {
      font-size: 18px;
    }

    .wc__finishes {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 24px;
    }

    .wc__finishes-label {
      display: inline;
      margin-right: 4px;
      font-size: 13px;
      color: var(--c-muted);
    }

    .wc__finishes ul {
      gap: 10px;
    }

    .wc__note {
      margin-top: 16px;
    }
  }
</style>
