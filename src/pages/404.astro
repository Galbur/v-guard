---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/index.ts';
import { localizedPath } from '../i18n/routes.ts';

const title = t('page.404.title', 'nl');
---

<Base locale="nl" title={title}>
  <h1>{title}</h1>
  <p><a class="btn" href={localizedPath('home', 'nl')}>{t('page.404.back', 'nl')}</a></p>
</Base>
