---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/index.ts';
import { localizedPath } from '../../i18n/routes.ts';

const title = t('page.404.title', 'uk');
---

<Base locale="uk" title={title}>
  <h1>{title}</h1>
  <p><a class="btn" href={localizedPath('home', 'uk')}>{t('page.404.back', 'uk')}</a></p>
</Base>
