---
// Car wrapping (/car-wrapping/, /uk/obkleiuvannia/): mockup «VG Site 04 Car wrapping v2».
// Order: Hero · Proof · Wat is car wrapping · Configurator · Cards · Finishes · Wrappen of
// overspuiten · Recent opgeleverd · Zo werkt het · FAQ (8) · CTA.
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';
import WrapAnswer from '../components/wrap/WrapAnswer.astro';
import WrapCards from '../components/wrap/WrapCards.astro';
import WrapCompare from '../components/wrap/WrapCompare.astro';
import WrapConfigurator from '../components/wrap/WrapConfigurator.astro';
import WrapCta from '../components/wrap/WrapCta.astro';
import WrapFinishes from '../components/wrap/WrapFinishes.astro';
import WrapHero from '../components/wrap/WrapHero.astro';
import WrapProof from '../components/wrap/WrapProof.astro';
import WrapRecent from '../components/wrap/WrapRecent.astro';
import WrapSteps from '../components/wrap/WrapSteps.astro';
import { headings } from '../copy/shared.ts';
import { wrapCopy } from '../copy/wrap.ts';
import { wrapCards, wrapFinishes, wrapRecent } from '../data/services.ts';
import { localizedPath, type Locale } from '../i18n/routes.ts';
import { faqSchema, serviceSchema } from '../lib/schema.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = wrapCopy[locale];
const url = new URL(localizedPath('wrap', locale), Astro.site ?? 'http://localhost').href;
const schema = [
  serviceSchema({
    name: c.h1,
    serviceType: 'Car wrapping',
    url,
    offers: wrapCards.map((w) => ({ name: w.title[locale], price: w.price })),
  }),
  faqSchema(c.faq),
];
---

<Base locale={locale} pageKey="wrap" title={c.title} description={c.description} schema={schema}>
  <WrapHero locale={locale} h1={c.h1} sub={c.sub} cta={c.ctaBuild} chips={c.chips} />
  <WrapProof items={c.proof} />
  <WrapAnswer title={c.answerTitle} text={c.answer} />
  <WrapConfigurator locale={locale} copy={c.cfg} />
  <WrapCards locale={locale} title={c.cardsTitle} button={c.cardButton} note={c.cardsNote} cards={wrapCards} />
  <WrapFinishes locale={locale} title={c.finishesTitle} finishes={wrapFinishes} />
  <WrapCompare locale={locale} title={c.compareTitle} cols={c.compareCols} rows={c.compare} ppf={c.comparePpf} />
  <WrapRecent locale={locale} title={c.recentTitle} more={c.recentMore} items={wrapRecent} />
  <WrapSteps title={c.stepsTitle} steps={c.steps} />
  <FAQ title={headings.faq[locale]} items={c.faq} />
  <WrapCta locale={locale} title={c.cta.title} text={c.cta.text} />
</Base>
