---
// Home (/ and /uk/): mockup «VG Site 01 Home», Blueprint v1.3 section 3. Hero, service cards and the
// process photo are AI illustrations (D18, step 15); real photos stay in the list of work.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import TrustBlock from '../components/TrustBlock.astro';
import ReviewsBlock from '../components/ReviewsBlock.astro';
import QuoteEntry from '../components/QuoteEntry.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { home } from '../copy/home.ts';
import { homeImages as img } from '../data/services.ts';
import { trustItems } from '../copy/shared.ts';
import { t } from '../i18n/index.ts';
import { localizedPath, type Locale } from '../i18n/routes.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = home[locale];
const recent = (await getCollection('projects', (p) => p.data.home)).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
---

<Base locale={locale} pageKey="home" title={c.title} description={c.description}>
  <Hero
    locale={locale}
    h1={c.h1}
    sub={c.sub}
    chips={c.chips}
    align="right"
    photos={{
      mobile: { file: img.hero375.value, position: 'center 50%' },
      desktop: { file: img.hero1280.value, position: 'center 50%' },
    }}
  />
  <ServiceCards
    locale={locale}
    title={c.servicesTitle}
    cards={[
      {
        slug: 'ppf',
        ...c.cards.ppf,
        href: localizedPath('ppf', locale),
        image: { file: img.cardPpf.value, position: 'center', alt: c.cardAlts.ppf },
      },
      {
        slug: 'ramen-blinderen',
        ...c.cards['ramen-blinderen'],
        href: localizedPath('tint', locale),
        image: { file: img.cardTint.value, position: 'center', alt: c.cardAlts['ramen-blinderen'] },
      },
      {
        slug: 'car-wrapping',
        ...c.cards['car-wrapping'],
        href: localizedPath('wrap', locale),
        image: { file: img.cardWrap.value, position: 'center', alt: c.cardAlts['car-wrapping'] },
      },
    ]}
  />
  <ProcessSteps
    title={c.processTitle}
    sub={c.processSub}
    steps={c.steps}
    image={{ file: img.process.value, alt: '' }}
  />
  <ProjectGallery
    locale={locale}
    title={c.recentTitle}
    items={recent}
    more={{ href: localizedPath('projects', locale), label: t('cta.allProjects', locale) }}
  />
  <TrustBlock title={c.whyTitle} items={trustItems[locale]} />
  <ReviewsBlock locale={locale} title={c.reviewsTitle} linkLabel={c.reviewsLink} />
  <QuoteEntry locale={locale} title={c.quoteTitle} text={c.quoteText} />
  <ContactBlock locale={locale} />
</Base>
