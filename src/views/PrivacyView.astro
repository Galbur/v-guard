---
// Privacy (/privacy/, /uk/privacy/): plain text page in the site style (no mockup). No FAQ, no CTA band.
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { privacyCopy, type PrivacyBlock } from '../copy/privacy.ts';
import type { Locale } from '../i18n/routes.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = privacyCopy[locale];

/** Text before and after the link label in a paragraph with a link. */
const split = (b: Exclude<PrivacyBlock, string | string[]>) => {
  const at = b.text.indexOf(b.link.label);
  return [b.text.slice(0, at), b.text.slice(at + b.link.label.length)];
};
---

<Base locale={locale} pageKey="privacy" title={c.title} description={c.description}>
  <PageIntro h1={c.h1}>
    <p class="privacy__updated">{c.updated.label} <time datetime={c.updated.iso}>{c.updated.date}</time></p>
    <p class="lead privacy__intro">{c.intro}</p>
  </PageIntro>
  <div class="container prose">
    {
      c.sections.map((s) => (
        <section>
          <h2>{s.title}</h2>
          {s.blocks.map((b) =>
            typeof b === 'string' ? (
              <p>{b}</p>
            ) : Array.isArray(b) ? (
              <ul>
                {b.map((li) => (
                  <li>{li}</li>
                ))}
              </ul>
            ) : (
              <p>
                {split(b)[0]}
                <a href={b.link.href} rel="noopener">
                  {b.link.label}
                </a>
                {split(b)[1]}
              </p>
            ),
          )}
        </section>
      ))
    }
  </div>
</Base>

<style>
  .prose {
    max-width: calc(720px + 2 * var(--gutter));
    margin-inline: 0;
    padding-block: 32px var(--section-gap);
    color: var(--c-text-soft);
    font-size: 16px;
    line-height: 1.6;
  }

  .prose section + section {
    margin-top: 32px;
  }

  h2 {
    margin-bottom: 8px;
    color: var(--c-off-white);
    font-size: 20px;
    line-height: 1.25;
    font-weight: 600;
  }

  p + p,
  p + ul,
  ul + p {
    margin-top: 8px;
  }

  .prose a {
    color: var(--c-off-white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .privacy__updated {
    color: var(--c-text-soft);
    font-size: 14px;
  }

  @media (min-width: 64rem) {
    .privacy__intro {
      max-width: 720px;
    }
  }

  ul {
    padding-left: 20px;
  }

  @media (min-width: 64rem) {
    .prose {
      margin-inline: auto;
      max-width: var(--container);
      padding-left: var(--gutter);
      padding-right: calc(var(--container) - 720px - var(--gutter));
    }
  }
</style>
