---
// PPF (/ppf/, /uk/ppf/): mockup «VG Site 02 PPF v2», Blueprint v1.3 service template.
// Hero and step photos are AI-generated illustrations (owner decision 06.10.2026), alt="".
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import AnswerBox from '../components/AnswerBox.astro';
import PackageCards from '../components/PackageCards.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import TrustBlock from '../components/TrustBlock.astro';
import FAQ from '../components/FAQ.astro';
import CtaBand from '../components/CtaBand.astro';
import { ppf } from '../copy/ppf.ts';
import { headings, prepSteps } from '../copy/shared.ts';
import { ppfPackages } from '../data/services.ts';
import { t } from '../i18n/index.ts';
import { localizedPath, type Locale } from '../i18n/routes.ts';
import { faqSchema, serviceSchema } from '../lib/schema.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = ppf[locale];
const projects = (await getCollection('projects', (p) => p.data.service === 'ppf')).sort((a, b) => a.data.order - b.data.order);
const url = new URL(localizedPath('ppf', locale), Astro.site ?? 'http://localhost').href;
const schema = [
  serviceSchema({
    name: c.h1,
    serviceType: 'Paint protection film',
    url,
    offers: ppfPackages.map((p) => ({ name: p.title[locale], price: p.price })),
  }),
  faqSchema(c.faq),
];
---

<Base locale={locale} pageKey="ppf" title={c.title} description={c.description} schema={schema}>
  <Hero
    locale={locale}
    h1={c.h1}
    sub={c.sub}
    chips={c.chips}
    service="ppf"
    waText={c.whatsapp}
    photos={{
      mobile: { file: 'ppf-hero-375.webp', position: 'center 70%' },
      desktop: { file: 'ppf-hero-1280.jpg', position: '70% center' },
    }}
  />
  <AnswerBox text={c.answer} />
  <PackageCards locale={locale} title={c.packagesTitle} note={c.packagesNote} service="ppf" packages={ppfPackages} />
  <ProcessSteps
    title={c.processTitle}
    sub={c.processSub}
    steps={prepSteps[locale]}
    photos={['ppf-step-wash.webp', 'ppf-step-clay.webp', 'ppf-step-degrease.webp', 'ppf-step-install.jpg', 'ppf-step-check.webp']}
  />
  <ProjectGallery
    locale={locale}
    title={c.galleryTitle}
    items={projects}
    more={{ href: localizedPath('projects', locale), label: t('cta.allProjects', locale) }}
  />
  <TrustBlock items={c.trust} />
  <FAQ title={headings.faq[locale]} items={c.faq} />
  <CtaBand locale={locale} title={c.cta.title} text={c.cta.text} service="ppf" waText={c.whatsapp} />
</Base>
