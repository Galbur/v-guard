---
// PPF (/ppf/, /uk/ppf/): mockup «VG Site 02 PPF», Blueprint v1.2 service template.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import AnswerBox from '../components/AnswerBox.astro';
import PackageCards from '../components/PackageCards.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import TrustBlock from '../components/TrustBlock.astro';
import FAQ from '../components/FAQ.astro';
import CtaBand from '../components/CtaBand.astro';
import { ppf } from '../copy/ppf.ts';
import { headings, prepSteps, trustItems } from '../copy/shared.ts';
import { ppfPackages } from '../data/services.ts';
import { localizedPath, type Locale } from '../i18n/routes.ts';
import { faqSchema, serviceSchema } from '../lib/schema.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = ppf[locale];
const projects = (await getCollection('projects', (p) => p.data.service === 'ppf')).sort((a, b) => a.data.order - b.data.order);
const url = new URL(localizedPath('ppf', locale), Astro.site ?? 'http://localhost').href;
const schema = [
  serviceSchema({
    name: c.h1,
    serviceType: 'Paint protection film',
    url,
    offers: ppfPackages.map((p) => ({ name: p.title[locale], price: p.price })),
  }),
  faqSchema(c.faq),
];
---

<Base locale={locale} pageKey="ppf" title={c.title} description={c.description} schema={schema}>
  <Hero
    locale={locale}
    h1={c.h1}
    sub={c.sub}
    chips={c.chips}
    service="ppf"
    photos={{ mobile: { file: 'hex-van-p2.jpg', position: 'center 40%' }, desktop: { file: 'hex-van-l1.jpg', position: 'center 60%' } }}
  />
  <AnswerBox title={c.answerTitle} text={c.answer} />
  <PackageCards locale={locale} title={c.packagesTitle} note={c.packagesNote} service="ppf" packages={ppfPackages} />
  <ProcessSteps title={headings.process[locale]} steps={prepSteps[locale]} />
  <ProjectGallery locale={locale} title={c.galleryTitle} items={projects} />
  <TrustBlock title={c.trustTitle} items={trustItems[locale]} />
  <FAQ title={headings.faq[locale]} items={c.faq} />
  <CtaBand locale={locale} title={c.cta.title} text={c.cta.text} service="ppf" />
</Base>
