---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyMobileBar from '../components/StickyMobileBar.astro';
import { LIVE_PAGES, site } from '../config/site.ts';
import { t, type UiKey } from '../i18n/index.ts';
import { hreflang, locales, localizedPath, type Locale, type PageKey } from '../i18n/routes.ts';

interface Props {
  locale: Locale;
  /** Undefined for 404 pages: no canonical, no alternates, no breadcrumbs. */
  pageKey?: PageKey;
  /** Full <title> (design prompt section 13). */
  title: string;
  description?: string;
  /** Extra JSON-LD nodes for this page (Service, FAQPage). */
  schema?: Record<string, unknown>[];
}

const { locale, pageKey, title, description, schema = [] } = Astro.props;
const origin = Astro.site;

const isLive = pageKey !== undefined && LIVE_PAGES.includes(pageKey);
const abs = (path: string) => (origin ? new URL(path, origin).href : path);
const canonical = pageKey && origin ? abs(localizedPath(pageKey, locale)) : null;
const alternates =
  pageKey && origin
    ? [
        ...locales.map((l) => ({ hreflang: hreflang[l], href: abs(localizedPath(pageKey, l)) })),
        { hreflang: 'x-default', href: abs(localizedPath(pageKey, 'nl')) },
      ]
    : [];

// AutoRepair on every page: same NAP as footer and contact block (CLAUDE.md rule 3).
const sameAs = Object.values(site.socials).filter((v): v is string => v !== null);
const business: Record<string, unknown> = {
  '@type': 'AutoRepair',
  '@id': `${abs('/')}#business`,
  name: site.name,
  url: abs('/'),
  telephone: site.phone.value.e164,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  openingHours: site.hours.value.schema,
  areaServed: ['Vroomshoop', 'Twente'],
  ...(sameAs.length ? { sameAs } : {}),
};

const pageName: Record<PageKey, UiKey> = {
  home: 'nav.home',
  ppf: 'nav.ppf',
  tint: 'nav.tint',
  wrap: 'nav.wrap',
  projects: 'nav.projects',
  contact: 'nav.contact',
  privacy: 'nav.privacy',
};
const breadcrumbs =
  pageKey && pageKey !== 'home'
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: t('nav.home', locale), item: abs(localizedPath('home', locale)) },
          { '@type': 'ListItem', position: 2, name: t(pageName[pageKey], locale), item: abs(localizedPath(pageKey, locale)) },
        ],
      }
    : null;

const graph = [business, ...(breadcrumbs ? [breadcrumbs] : []), ...schema];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {!isLive && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="format-detection" content="telephone=no" />
    <slot name="head" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skip', locale)}</a>
    <Header locale={locale} pageKey={pageKey} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <StickyMobileBar locale={locale} />
  </body>
</html>
